{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libraz.net/midi-sketch-bach/schema/generated.v1.json",
  "title": "midi-sketch-bach generated score",
  "type": "object",
  "required": [
    "schema_version",
    "ticks_per_beat",
    "duration_ticks",
    "notes",
    "counterpoint_observations",
    "informational_findings",
    "wave_veto"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "generated.v1"
    },
    "ticks_per_beat": {
      "type": "integer",
      "minimum": 1
    },
    "duration_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "tempos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tick",
          "bpm"
        ],
        "additionalProperties": false,
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "bpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "start_tick",
          "duration",
          "pitch",
          "voice",
          "velocity"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "pitch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "voice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        }
      }
    },
    "counterpoint_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "geometry",
          "total",
          "gated",
          "exempted"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "geometry": {
            "type": "string",
            "enum": [
              "linear",
              "vertical",
              "unclassified"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 1
          },
          "gated": {
            "type": "integer",
            "minimum": 0
          },
          "exempted": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "informational_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "span_id",
          "rule_id",
          "geometry",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "span_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "rule_id": {
            "type": "string"
          },
          "geometry": {
            "type": "string",
            "enum": [
              "linear",
              "vertical",
              "unclassified"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "StructuralFail",
              "MusicalFail",
              "ConfigFail"
            ]
          }
        }
      }
    },
    "wave_veto": {
      "type": "object",
      "required": [
        "anchor_parallel_displaced",
        "wobble_breaker_fired",
        "step_parallel_adjusted",
        "step_harsh_adjusted",
        "order_clamp_changed",
        "window_expanded",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor_parallel_displaced": {
          "type": "integer",
          "minimum": 0
        },
        "wobble_breaker_fired": {
          "type": "integer",
          "minimum": 0
        },
        "step_parallel_adjusted": {
          "type": "integer",
          "minimum": 0
        },
        "step_harsh_adjusted": {
          "type": "integer",
          "minimum": 0
        },
        "order_clamp_changed": {
          "type": "integer",
          "minimum": 0
        },
        "window_expanded": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "info": {
      "type": "object"
    }
  }
}
